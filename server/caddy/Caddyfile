{
	email {$ACME_EMAIL}
}

# 监听非标端口（规避国内服务器 80/443 备案）。证书走 DNS-01，不需要入站 80。
{$NTFY_DOMAIN}:{$PUBLIC_HTTPS_PORT} {
	# ===== Cloudflare（默认）=====
	# 需要 Dockerfile 用 --with github.com/caddy-dns/cloudflare 构建
	tls {
		dns cloudflare {$DNS_API_TOKEN}
	}

	# ===== 腾讯云 DNSPod（如改用，注释掉上面的 tls 块，启用下面这个）=====
	# Dockerfile 改 DNS_PLUGIN=tencentcloud，并在 .env 把 DNS_API_TOKEN 拆成两行环境变量
	# tls {
	# 	dns tencentcloud {
	# 		secret_id {$TENCENT_SECRET_ID}
	# 		secret_key {$TENCENT_SECRET_KEY}
	# 	}
	# }

	# ===== 阿里云 AliDNS =====
	# Dockerfile 改 DNS_PLUGIN=alidns
	# tls {
	# 	dns alidns {
	# 		access_key_id {$ALI_ACCESS_KEY_ID}
	# 		access_key_secret {$ALI_ACCESS_KEY_SECRET}
	# 	}
	# }

	handle /icons/* {
		reverse_proxy icon-uploader:8080
	}

	handle /ai/* {
		reverse_proxy ai-hub:8081
	}

	handle /healthz {
		reverse_proxy ai-hub:8081
	}

	handle {
		reverse_proxy ntfy:80
	}
}
