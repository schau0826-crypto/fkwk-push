# ====== fkwk-push optional server config ======
# Copy this file to .env and fill your own values: cp .env.example .env

# Your public domain, without https:// or port
NTFY_DOMAIN=push.example.com

# Public HTTPS port. 8443 is a common choice for personal deployments.
PUBLIC_HTTPS_PORT=8443

# Let's Encrypt 注册邮箱（证书到期提醒用）
ACME_EMAIL=you@example.com

# ====== DNS-01 证书签发（绕开 80 端口，无需备案）======
# DNS provider used by Caddy DNS-01. Options: cloudflare / tencentcloud / alidns
DNS_PROVIDER=cloudflare
# Provider API token / credentials
# - cloudflare:  填一个具备 Zone.DNS 编辑权限的 API Token
# - tencentcloud(DNSPod): 填 "SecretId SecretKey"（中间空格分隔）
# - alidns:      填 "AccessKeyId AccessKeySecret"
DNS_API_TOKEN=your-dns-api-token

# ====== ntfy 鉴权 ======
# 部署后用 deploy.sh 自动创建以下账号；这里只是记录，便于你保存
# Admin user. deploy.sh can create a publishing token for it.
NTFY_ADMIN_USER=fkwk
NTFY_ADMIN_PASS=change-me-strong-password

# ====== Bark 图标自动上传 ======
# When an app is selected, fkwk-push can PUT the Android app icon to:
# https://${NTFY_DOMAIN}:${PUBLIC_HTTPS_PORT}/icons/<package>.png
ICON_UPLOAD_TOKEN=change-me-icon-upload-token

# ====== AI Hub（可选）======
# Android app 上报结构化通知事件时使用的 Bearer token
AI_HUB_TOKEN=change-me-ai-hub-token

# OpenAI-compatible provider. 兼容 OpenAI / OpenRouter / 自建兼容接口
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=change-me-openai-compatible-key
OPENAI_MODEL=gpt-4o-mini

# 飞书自定义机器人 webhook。留空则只生成简报，不主动推送到飞书
FEISHU_WEBHOOK_URL=

# 确认 Todo 后用于推送到 iPhone 的 Bark 出口。也可与 Android App 内配置不同
BARK_SERVER_URL=https://api.day.app
BARK_DEVICE_KEY=change-me-bark-key
